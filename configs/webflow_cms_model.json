{
  "project": "Kingdom Construction TX",
  "market": "DFW",
  "collections": [
    {
      "name": "services",
      "purpose": "Primary local service pages",
      "fields": [
        { "name": "slug", "type": "plain_text", "required": true, "unique": true },
        { "name": "service_name", "type": "plain_text", "required": true },
        { "name": "primary_city", "type": "plain_text", "required": true },
        { "name": "summary", "type": "rich_text", "required": true },
        { "name": "process_steps", "type": "rich_text", "required": false },
        { "name": "hero_media", "type": "image", "required": true },
        { "name": "faq_refs", "type": "multi_reference", "required": false, "reference": "faqs" },
        { "name": "schema_fields", "type": "plain_text", "required": true, "format": "json-string" },
        { "name": "seo_title", "type": "plain_text", "required": true },
        { "name": "seo_meta_description", "type": "plain_text", "required": true },
        { "name": "is_published", "type": "switch", "required": true, "default": false }
      ]
    },
    {
      "name": "projects",
      "purpose": "Project/case-study social proof",
      "fields": [
        { "name": "slug", "type": "plain_text", "required": true, "unique": true },
        { "name": "project_type", "type": "option", "required": true },
        { "name": "city", "type": "plain_text", "required": true },
        { "name": "scope", "type": "rich_text", "required": true },
        { "name": "outcomes", "type": "rich_text", "required": true },
        { "name": "before_after_media", "type": "multi_image", "required": false },
        { "name": "testimonial_ref", "type": "reference", "required": false, "reference": "reviews" },
        { "name": "seo_title", "type": "plain_text", "required": true },
        { "name": "seo_meta_description", "type": "plain_text", "required": true }
      ]
    },
    {
      "name": "blog_posts",
      "purpose": "Education + long-tail SEO/AEO",
      "fields": [
        { "name": "slug", "type": "plain_text", "required": true, "unique": true },
        { "name": "title", "type": "plain_text", "required": true },
        { "name": "author", "type": "plain_text", "required": true },
        { "name": "publish_date", "type": "date_time", "required": true },
        { "name": "body", "type": "rich_text", "required": true },
        { "name": "faq_snippets", "type": "rich_text", "required": false },
        { "name": "entity_tags", "type": "plain_text", "required": false, "format": "comma-separated" },
        { "name": "seo_title", "type": "plain_text", "required": true },
        { "name": "seo_meta_description", "type": "plain_text", "required": true }
      ]
    },
    {
      "name": "service_areas",
      "purpose": "Local SEO geo pages",
      "fields": [
        { "name": "slug", "type": "plain_text", "required": true, "unique": true },
        { "name": "city", "type": "plain_text", "required": true },
        { "name": "state", "type": "plain_text", "required": true, "default": "TX" },
        { "name": "radius_miles", "type": "number", "required": false },
        { "name": "priority", "type": "number", "required": true },
        { "name": "proof_points", "type": "rich_text", "required": true },
        { "name": "services_refs", "type": "multi_reference", "required": false, "reference": "services" },
        { "name": "seo_title", "type": "plain_text", "required": true },
        { "name": "seo_meta_description", "type": "plain_text", "required": true }
      ]
    },
    {
      "name": "faqs",
      "purpose": "Answer engine extraction blocks",
      "fields": [
        { "name": "question", "type": "plain_text", "required": true },
        { "name": "short_answer", "type": "plain_text", "required": true },
        { "name": "long_answer", "type": "rich_text", "required": true },
        { "name": "service_ref", "type": "reference", "required": false, "reference": "services" },
        { "name": "area_ref", "type": "reference", "required": false, "reference": "service_areas" },
        { "name": "sort_order", "type": "number", "required": false }
      ]
    },
    {
      "name": "reviews",
      "purpose": "Trust and conversion support",
      "fields": [
        { "name": "reviewer", "type": "plain_text", "required": true },
        { "name": "source", "type": "option", "required": true },
        { "name": "rating", "type": "number", "required": true },
        { "name": "quote", "type": "rich_text", "required": true },
        { "name": "date", "type": "date_time", "required": false },
        { "name": "service_ref", "type": "reference", "required": false, "reference": "services" },
        { "name": "area_ref", "type": "reference", "required": false, "reference": "service_areas" }
      ]
    }
  ],
  "editorial_rules": {
    "seo_title_max_chars": 60,
    "seo_meta_description_max_chars": 160,
    "must_include_city_on_area_pages": true,
    "must_include_local_intent_on_service_pages": true,
    "ban_duplicate_slugs_across_collections": true
  }
}
